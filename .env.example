# X session cookies. Log in to X in your browser with your passkey, then copy these two
# cookies from DevTools > Application > Cookies > https://x.com. They survive in
# cookies.json after the first run, so you only need them once (until they expire).
X_AUTH_TOKEN=...
X_CT0=...

# Optional knobs
# CLAUDE_MODEL=haiku
# HOURS_BACK=24
# MAX_TWEETS=150
# MIN_SCORE=6              # minimum score to appear in the markdown digest
# REPOST_MIN_SCORE=8       # reposted to your timeline at or above this score
# LIKE_MIN_SCORE=9         # also liked at or above this score
# REPOST_MAX_PER_RUN=25    # safety cap on reposts per run
