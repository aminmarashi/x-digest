# X login. Use 1Password secret references (op://<vault>/<item>/<field>) so no secret
# ever sits in this file; the script resolves them at runtime with the op CLI.
# Plain values also work if you don't use 1Password.
X_USERNAME=op://Personal/X/username
X_EMAIL=op://Personal/X/email
X_PASSWORD=op://Personal/X/password

# Only if the account has an authenticator app set up: the base32 TOTP secret
# X_TOTP_SECRET=op://Personal/X/totp secret

# Optional knobs
# CLAUDE_MODEL=haiku
# HOURS_BACK=24
# MAX_TWEETS=150
# MIN_SCORE=6
