# X session cookies. Values of the form op://<vault>/<item>/<field> are resolved at runtime
# with the 1Password CLI, so no secret is stored in this file. Plain values also work.
#
# Log in to X in your browser with your passkey, then copy these two cookies from
# DevTools > Application > Cookies > https://x.com. They survive in cookies.json after the
# first run, so you only need them once (until they expire).
X_AUTH_TOKEN=op://Personal/X/auth_token
X_CT0=op://Personal/X/ct0

# Optional knobs
# CLAUDE_MODEL=haiku
# HOURS_BACK=24
# MAX_TWEETS=150
# MIN_SCORE=6
